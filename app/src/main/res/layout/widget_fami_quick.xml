<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- Hoja de Notita Adhesiva Fami con Sombra 3D idéntica a la tarjeta de la app -->
    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_sticky_note_bg"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- ENCABEZADO IDÉNTICO A LA NOTITA FLOTANTE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="NOTA RÁPIDA CON FAMI IA ✏️"
                android:textColor="@color/widget_sticky_ink"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Escribe, dicta o escanea sin abrir la app"
                android:textColor="@color/widget_sticky_ink_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- FILA 1: Campo "Escribe o dicta tu gasto..." + Botón 3D Voz (Menta) + Botón 3D Enviar (Coral) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Campo de entrada estilo papel que abre el teclado directo sobre la pantalla de inicio -->
            <LinearLayout
                android:id="@+id/widget_btn_write"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_input_field_bg"
                android:clickable="true"
                android:contentDescription="Escribir gasto o ingreso"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Escribe o dicta tu gasto..."
                    android:textColor="@color/widget_sticky_ink_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Botón 3D Micrófono (Menta) -->
            <LinearLayout
                android:id="@+id/widget_btn_voice"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:background="@drawable/widget_btn_mint"
                android:clickable="true"
                android:contentDescription="Dictar movimiento por voz"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_mic" />
            </LinearLayout>

            <!-- Botón 3D Enviar (Coral) -->
            <LinearLayout
                android:id="@+id/widget_btn_send"
                android:layout_width="42dp"
                android:layout_height="match_parent"
                android:background="@drawable/widget_btn_coral"
                android:clickable="true"
                android:contentDescription="Registrar movimiento escrito"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_send" />
            </LinearLayout>
        </LinearLayout>

        <!-- FILA 2: Botones 3D ESCANEAR (Coral) y GALERÍA (Azul Marino) idénticos a la notita de Fami -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Botón 3D ESCANEAR -->
            <LinearLayout
                android:id="@+id/widget_btn_scan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_coral"
                android:clickable="true"
                android:contentDescription="Escanear recibo con cámara"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="ESCANEAR"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botón 3D GALERÍA -->
            <LinearLayout
                android:id="@+id/widget_btn_gallery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_navy"
                android:clickable="true"
                android:contentDescription="Seleccionar recibo de galería"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="2dp">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_gallery" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="GALERÍA"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Cinta adhesiva decorativa superior (estilo notita Fami con borde de tinta) -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="9dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/widget_sticky_tape" />

</FrameLayout>
