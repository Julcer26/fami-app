<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <!-- Notita adhesiva principal -->
    <LinearLayout
        android:id="@+id/widget_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_sticky_note_bg"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- Etiqueta discreta estilo notita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="FAMI · REGISTRO RÁPIDO"
                android:textColor="@color/widget_sticky_ink_muted"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4 botones táctiles estilo noticas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 1. Escribir -->
            <LinearLayout
                android:id="@+id/widget_btn_write"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_peach"
                android:clickable="true"
                android:contentDescription="Escribir movimiento"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_edit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Escribir"
                    android:textColor="@color/widget_sticky_ink"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. Voz -->
            <LinearLayout
                android:id="@+id/widget_btn_voice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_mint"
                android:clickable="true"
                android:contentDescription="Dictar movimiento por voz"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_mic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Voz"
                    android:textColor="@color/widget_sticky_ink"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Escanear -->
            <LinearLayout
                android:id="@+id/widget_btn_scan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_coral"
                android:clickable="true"
                android:contentDescription="Escanear recibo con cámara"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_camera" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Escanear"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 4. Galería -->
            <LinearLayout
                android:id="@+id/widget_btn_gallery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_btn_sky"
                android:clickable="true"
                android:contentDescription="Seleccionar recibo de galería"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="6dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_gallery" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Galería"
                    android:textColor="@color/widget_sticky_ink"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Cinta adhesiva decorativa superior (estilo notica Fami) -->
    <ImageView
        android:layout_width="52dp"
        android:layout_height="9dp"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/widget_sticky_tape" />

</FrameLayout>
